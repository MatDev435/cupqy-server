# =============================================================================
# Cupqy API — variáveis de ambiente
# Copie para ".env" e preencha. NUNCA versione o arquivo .env com valores reais.
# =============================================================================

# --- Servidor -----------------------------------------------------------------
NODE_ENV=development
PORT=3333
# fatal | error | warn | info | debug | trace | silent (padrão: info em produção, debug em dev)
LOG_LEVEL=
# Número de proxies confiáveis à frente da API (Render = 1)
TRUST_PROXY=1
# Exige HTTPS (padrão: true em produção)
FORCE_HTTPS=
JSON_BODY_LIMIT=100kb
# Publica a documentação Swagger em /api/docs
API_DOCS_ENABLED=true

# --- CORS ---------------------------------------------------------------------
# Origens permitidas separadas por vírgula. Aceita curinga para previews da Vercel.
CORS_ORIGINS=http://localhost:5173,https://cupqy.vercel.app,https://cupqy-*.vercel.app

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000

# --- Banco de dados (Supabase PostgreSQL) -------------------------------------
# Usada pela API em execução: pooler do Supabase em modo TRANSAÇÃO (porta 6543).
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Usada apenas pelas migrations (Prisma CLI): pooler em modo SESSÃO (porta 5432).
DIRECT_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Conexões simultâneas por instância da API
DATABASE_POOL_MAX=10
# (Opcional) Certificado da CA do Supabase em PEM (quebras de linha como \n) para validar o TLS.
# Se usar, NÃO inclua "sslmode" nas URLs acima.
DATABASE_SSL_CA=

# Banco local opcional (npm run db:local), sem Supabase:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/cupqy

# --- Supabase (Auth e Storage) ------------------------------------------------
# Project Settings → API. Aceita as chaves legadas (anon/service_role) ou as novas
# (sb_publishable_... / sb_secret_...).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave pública (também usada pelo front-end)
SUPABASE_ANON_KEY=
# Chave secreta — SOMENTE no servidor. Nunca exponha no front-end.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket (público para leitura) com as fotos dos cupcakes
SUPABASE_STORAGE_BUCKET=cupcake-images

# --- Loja -----------------------------------------------------------------------
# Fuso horário usado no estoque diário e nos relatórios (hoje/semana/mês)
STORE_TIMEZONE=America/Sao_Paulo
# Abaixo desta quantidade o painel de estoque exibe alerta de estoque baixo
LOW_STOCK_THRESHOLD=5
STORE_NAME=Cupqy
# Endereço exibido para retirada na loja
STORE_ADDRESS=Rua Augusta, 1500 - Consolação, São Paulo - SP, 01304-001
# Coordenadas da loja (origem do cálculo de distância do frete)
STORE_LATITUDE=-23.5558
STORE_LONGITUDE=-46.6622
# Tempo médio de preparo (prazo da retirada e base do prazo de entrega)
STORE_PREPARATION_MINUTES=30

# --- Frete (delivery) -----------------------------------------------------------
# frete = DELIVERY_BASE_FEE_CENTS + distância_km × DELIVERY_FEE_PER_KM_CENTS
# distância_km = linha reta (Haversine) × DELIVERY_ROUTE_FACTOR (aproxima o trajeto real)
DELIVERY_BASE_FEE_CENTS=500
DELIVERY_FEE_PER_KM_CENTS=150
DELIVERY_MAX_DISTANCE_KM=15
DELIVERY_ROUTE_FACTOR=1.3
DELIVERY_AVERAGE_SPEED_KMH=25

# --- Front-end e URL pública da API -------------------------------------------
# Front-end (Vercel): destino dos retornos do Checkout Pro
FRONTEND_URL=http://localhost:5173
# Rota da tela do pedido no front-end (":orderId" é substituído pelo id)
FRONTEND_ORDER_PATH=/pedidos/:orderId
# URL pública HTTPS desta API (Render). Necessária para o Mercado Pago enviar webhooks.
API_PUBLIC_URL=

# --- Mercado Pago (Checkout Pro) — use SEMPRE credenciais de TESTE ---------------
# Suas integrações → aplicação → Credenciais de teste → Access Token
MERCADOPAGO_ACCESS_TOKEN=
# Suas integrações → Webhooks → Assinatura secreta (valida a origem das notificações)
MERCADOPAGO_WEBHOOK_SECRET=
# true = usa o link de sandbox do Checkout Pro (sem dinheiro real)
MERCADOPAGO_SANDBOX=true
# Nome que aparece na fatura do cartão (até 22 caracteres)
MERCADOPAGO_STATEMENT_DESCRIPTOR=CUPQY
MERCADOPAGO_TIMEOUT_MS=10000

# --- Pedidos ----------------------------------------------------------------------
# Prazo para pagar um pedido (mínimo 30: limite do Pix no Mercado Pago). Depois disso o
# pedido é cancelado automaticamente.
PAYMENT_EXPIRATION_MINUTES=30
# Pedidos simultâneos "aguardando pagamento" permitidos por cliente
MAX_PENDING_ORDERS_PER_USER=5

# --- Jobs em segundo plano ---------------------------------------------------------
# Cancelamento automático de pedidos não pagos (padrão: ativo, exceto nos testes)
JOBS_ENABLED=true
EXPIRE_ORDERS_INTERVAL_SECONDS=60

# --- APIs externas de CEP/geocodificação (BrasilAPI, ViaCEP, Nominatim) ---------
EXTERNAL_HTTP_TIMEOUT_MS=4000
# Identificação exigida pela política de uso do Nominatim (OpenStreetMap)
GEOCODING_USER_AGENT=cupqy-server/1.0
