# =============================================================================
# Cupqy API — variáveis de ambiente
# Copie para ".env" e preencha. NUNCA versione o arquivo .env com valores reais.
# =============================================================================

# --- Servidor -----------------------------------------------------------------
NODE_ENV=development
PORT=3333
# fatal | error | warn | info | debug | trace | silent (padrão: info em produção, debug em dev)
LOG_LEVEL=
# Número de proxies confiáveis à frente da API (Render = 1)
TRUST_PROXY=1
# Exige HTTPS (padrão: true em produção)
FORCE_HTTPS=
JSON_BODY_LIMIT=100kb

# --- CORS ---------------------------------------------------------------------
# Origens permitidas separadas por vírgula. Aceita curinga para previews da Vercel.
CORS_ORIGINS=http://localhost:5173,https://cupqy.vercel.app,https://cupqy-*.vercel.app

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000

# --- Banco de dados (Supabase PostgreSQL) -------------------------------------
# Usada pela API em execução: pooler do Supabase em modo TRANSAÇÃO (porta 6543).
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Usada apenas pelas migrations (Prisma CLI): pooler em modo SESSÃO (porta 5432).
DIRECT_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Conexões simultâneas por instância da API
DATABASE_POOL_MAX=10
# (Opcional) Certificado da CA do Supabase em PEM (quebras de linha como \n) para validar o TLS.
# Se usar, NÃO inclua "sslmode" nas URLs acima.
DATABASE_SSL_CA=

# Banco local opcional (npm run db:local), sem Supabase:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/cupqy

# --- Supabase (Auth e Storage) ------------------------------------------------
# Project Settings → API. Aceita as chaves legadas (anon/service_role) ou as novas
# (sb_publishable_... / sb_secret_...).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave pública (também usada pelo front-end)
SUPABASE_ANON_KEY=
# Chave secreta — SOMENTE no servidor. Nunca exponha no front-end.
SUPABASE_SERVICE_ROLE_KEY=

# --- Loja -----------------------------------------------------------------------
# Fuso horário usado no estoque diário e nos relatórios (hoje/semana/mês)
STORE_TIMEZONE=America/Sao_Paulo
