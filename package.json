{
  "name": "cupqy-server",
  "version": "0.1.0",
  "description": "API REST do Cupqy — e-commerce de cupcakes (Node.js, Express, Supabase, Prisma, Mercado Pago)",
  "main": "src/server.js",
  "scripts": {
    "test": "vitest run",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:local": "node scripts/local-db.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:supabase": "prisma db execute --file supabase/sql/01_security.sql && prisma db execute --file supabase/sql/02_realtime.sql",
    "test:integration": "vitest run --project integration",
    "admin:promote": "node scripts/promote-admin.js"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.1.0",
    "embedded-postgres": "^17.9.0-beta.16",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@embedded-postgres/linux-x64@17.9.0-beta.17": true
  }
}
